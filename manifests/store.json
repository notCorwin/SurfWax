{
  "manifest_version": 3,
  "name": "Surf Wax",
  "version": "0.2.0",
  "description": "在 Chrome 侧边栏中运行使用自选模型的浏览器智能体。",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Surf Wax",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "browsingData",
    "cookies",
    "debugger",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "devtools_page": "devtools.html"
}
