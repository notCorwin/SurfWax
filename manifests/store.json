{
  "manifest_version": 3,
  "name": "Surf Wax",
  "description": "在 Chrome 侧边栏中运行使用自选模型的浏览器智能体。",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Surf Wax",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "sandbox": { "pages": ["program-sandbox.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval' blob:; worker-src blob:; child-src blob:; connect-src 'none';"
  },
  "permissions": [
    "debugger",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/chrome/guard-content.ts"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_origin_as_fallback": true
    }
  ]
}
