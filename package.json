{
  "name": "surf-wax",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "build": "vite build && node scripts/validate-build.mjs",
    "check": "npm run lint && tsc --noEmit && vite build --outDir .dev/check-dist && node scripts/validate-build.mjs .dev/check-dist",
    "lint": "biome lint src e2e scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/prepare-upgrade-fixture.mjs && node scripts/run-playwright.mjs --grep-invert @performance",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "docs:check": "node scripts/generate-tool-docs.mjs --check",
    "release:package": "node scripts/package-release.mjs --build",
    "test:performance": "npm run build && node scripts/run-playwright.mjs e2e/render-performance.spec.ts --grep @performance --trace=off --retries=3 && node scripts/run-playwright.mjs e2e/performance.spec.ts --grep @performance --trace=off --retries=3",
    "measure:tools": "node scripts/measure-tool-budget.mjs",
    "sdk:check": "node scripts/check-sdk-coverage.mjs",
    "catalog:update": "node scripts/update-model-catalog.mjs",
    "catalog:check": "node scripts/update-model-catalog.mjs --check",
    "store:assets": "npm run build && node scripts/capture-store-assets.mjs",
    "verify:local": "node scripts/verify-local.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.116",
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/azure": "^4.0.102",
    "@ai-sdk/cerebras": "^3.0.69",
    "@ai-sdk/cohere": "^4.0.61",
    "@ai-sdk/deepinfra": "^3.0.69",
    "@ai-sdk/deepseek": "^3.0.65",
    "@ai-sdk/gateway": "^4.0.114",
    "@ai-sdk/google": "^4.0.96",
    "@ai-sdk/google-vertex": "^5.0.112",
    "@ai-sdk/groq": "^4.0.61",
    "@ai-sdk/mistral": "^4.0.64",
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/openai-compatible": "^3.0.69",
    "@ai-sdk/perplexity": "^5.0.12",
    "@ai-sdk/togetherai": "^3.0.70",
    "@ai-sdk/xai": "^5.0.22",
    "@aihubmix/ai-sdk-provider": "^2.2.1",
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@saladtechnologies-oss/ai-sdk-provider": "^0.2.0",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@streamdown/math": "^1.0.3",
    "@tanstack/react-virtual": "^3.14.19",
    "ai": "^7.0.141",
    "codemirror": "^6.0.2",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "merge-gateway-ai-sdk-provider": "^0.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.0",
    "tw-shimmer": "^0.4.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@crxjs/vite-plugin": "^3.0.0",
    "@playwright/test": "^1.64.1",
    "@smithy/eventstream-codec": "^4.5.2",
    "@smithy/util-utf8": "^4.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
